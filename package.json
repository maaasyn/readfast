{
    "name": "readfast",
    "version": "1.0.1",
    "description": "A reading helper that displays words with minimal eye movement using RSVP technique",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Maaasyn/readfast.git"
    },
    "homepage": "https://github.com/Maaasyn/readfast#readme",
    "bugs": {
        "url": "https://github.com/Maaasyn/readfast/issues"
    },
    "main": "dist/index.js",
    "bin": {
        "readfast": "dist/index.js",
        "rdx": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "install-cli": "pnpm run build && pnpm link --global",
        "test": "vitest"
    },
    "keywords": [
        "cli",
        "reading",
        "rsvp",
