        "string-width": "^8.1.1",
        "strip-ansi": "^7.1.2"
    },
    "devDependencies": {
        "@types/node": "^25.1.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}